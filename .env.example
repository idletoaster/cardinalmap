# --- Server ---
PORT=3000
NODE_ENV=production
PUBLIC_ORIGIN=

# --- Postgres / PostGIS ---
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=cardinalmap
PGPASSWORD=cardinalmap_dev_pw
PGDATABASE=cardinalmap

# --- Admin token (for /api/admin/* routes) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=replace_me_with_a_long_random_hex_string

# --- External services ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=CardinalMap/1.0 (https://example.com/cardinalmap)
OVERPASS_BASE_URL=https://overpass-api.de/api
OVERPASS_USER_AGENT=CardinalMap/1.0

# --- App config (mirrors config/index.js defaults) ---
APP_COUNTRY_CODE=us
APP_DISTANCE_UNIT=miles
APP_MAX_RADIUS_MILES=10
APP_MIN_RADIUS_MILES=5
APP_CACHE_TTL_DAYS=30
